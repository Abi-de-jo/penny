  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width decisive action for onboarding and expense saving.",
      "html": "<button class=\"ds-btn-primary\">Save expense</button>",
      "css": ".ds-btn-primary{width:100%;min-height:54px;border:0;border-radius:18px;padding:0 24px;background:#6540D7;color:#fff;font:600 14px/20px sans-serif;transition:filter .18s ease,transform .18s ease}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:active{transform:scale(.985)}.ds-btn-primary:focus-visible{outline:3px solid #34D9EA;outline-offset:3px}.ds-btn-primary:disabled{opacity:.38}"
    },
    {
      "name": "Glass Panel",
      "kind": "card",
      "refersTo": "glass-panel-light",
      "description": "Default translucent grouping surface for related ledger content.",
      "html": "<section class=\"ds-glass-panel\"><strong>Today</strong><p>Captured movements stay grouped and readable.</p></section>",
      "css": ".ds-glass-panel{border-radius:24px;padding:18px;background:rgba(252,249,255,.82);color:#1C1822;box-shadow:0 1px 4px rgba(101,64,215,.10);font-family:sans-serif}.ds-glass-panel strong{font-size:16px;line-height:22px}.ds-glass-panel p{margin:8px 0 0;color:#645E6C;font-size:14px;line-height:20px}.ds-glass-panel:hover{background:rgba(252,249,255,.9)}.ds-glass-panel:focus-within{outline:3px solid rgba(52,217,234,.65);outline-offset:2px}"
    },
    {
      "name": "Liquid Balance Lobe",
      "kind": "custom",
      "refersTo": "balance-lobe",
      "description": "Signature home summary with live-SMS status, bounded amount auto-sizing, spring focus, and a traveling three-segment highlight.",
      "html": "<section class=\"ds-balance-lobe\"><div class=\"ds-balance-meta\"><span>TODAY'S FLOW</span><b>SMS LIVE</b></div><span class=\"ds-balance-label\">Spent today</span><strong>₹12,50,000</strong><div class=\"ds-balance-selector\"><button class=\"ds-balance-selected\">Spent<br><b>₹12,50,000</b></button><button>In<br><b>₹5,000</b></button><button>Out<br><b>₹12,50,000</b></button></div></section>",
      "css": ".ds-balance-lobe{height:252px;padding:24px;border-radius:38px 24px 42px 24px;background:radial-gradient(circle at 93% 6%,rgba(255,255,255,.12),transparent 34%),radial-gradient(circle at 18% 102%,rgba(52,217,234,.18),transparent 30%),linear-gradient(135deg,#4221B8,#6534C7,#A42D7E);color:#fff;box-shadow:0 12px 24px rgba(117,71,255,.30);font-family:sans-serif;display:flex;flex-direction:column}.ds-balance-meta{display:flex;align-items:center;justify-content:space-between;color:rgba(255,255,255,.82);font:500 11px/14px sans-serif}.ds-balance-meta b{padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.14);color:#fff;font:500 11px/14px sans-serif}.ds-balance-label{margin-top:8px;font-size:14px;font-weight:600}.ds-balance-lobe>strong{height:58px;overflow:hidden;white-space:nowrap;font-size:clamp(20px,12vw,48px);line-height:58px;letter-spacing:-.8px}.ds-balance-selector{margin-top:auto;height:78px;padding:5px;border-radius:20px;background:rgba(0,0,0,.14);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}.ds-balance-selector button{min-width:0;overflow:hidden;border:0;border-radius:16px;background:transparent;color:#fff;font:500 12px/16px sans-serif}.ds-balance-selector button b{display:block;overflow:hidden;white-space:nowrap;font-size:clamp(10px,4.6vw,20px);line-height:22px}.ds-balance-selector button:hover{background:rgba(255,255,255,.10)}.ds-balance-selector button:focus-visible{outline:3px solid #34D9EA;outline-offset:-3px}.ds-balance-selector button:active{transform:scale(.98)}.ds-balance-selector .ds-balance-selected{background:rgba(255,255,255,.18)}"
    },
    {
      "name": "Outlined Expense Field",
      "kind": "input",
      "description": "Material-style single-line field for the human title a bank alert cannot provide.",
      "html": "<label class=\"ds-field\"><span>What was this for?</span><input placeholder=\"Food, petrol, groceries…\"><small>0/60</small></label>",
      "css": ".ds-field{display:grid;gap:8px;color:#1C1822;font-family:sans-serif}.ds-field>span{font-size:16px;line-height:22px;font-weight:600}.ds-field input{min-height:54px;padding:0 16px;border:1px solid #837B8B;border-radius:16px;background:transparent;color:#1C1822;font:400 16px/24px sans-serif;transition:border-color .18s,box-shadow .18s}.ds-field input:hover{border-color:#6540D7}.ds-field input:focus-visible{outline:0;border-color:#6540D7;box-shadow:0 0 0 2px rgba(101,64,215,.24)}.ds-field small{justify-self:end;color:#645E6C;font-size:12px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "description": "Compact Material filter for history date ranges.",
      "html": "<button class=\"ds-filter-chip\" aria-pressed=\"true\">Last 7 days</button>",
      "css": ".ds-filter-chip{min-height:40px;padding:0 16px;border:0;border-radius:12px;background:#EDE6FF;color:#6540D7;font:600 14px/20px sans-serif;transition:background .18s,transform .18s}.ds-filter-chip:hover{background:#e3d9ff}.ds-filter-chip:active{transform:scale(.97)}.ds-filter-chip:focus-visible{outline:3px solid #34D9EA;outline-offset:2px}"
    },
    {
      "name": "Transaction Row",
      "kind": "custom",
      "refersTo": "transaction-icon",
      "description": "Scan-first money movement row shared inside a glass panel.",
      "html": "<button class=\"ds-transaction-row\"><span class=\"ds-transaction-icon\">↗</span><span class=\"ds-transaction-copy\"><strong>Add a title</strong><small>Bank ••1234 · 10:42 AM</small></span><span class=\"ds-transaction-value\"><strong>−₹250</strong><small>Pending</small></span></button>",
      "css": ".ds-transaction-row{width:100%;min-height:74px;padding:14px 0;border:0;background:transparent;color:#1C1822;font-family:sans-serif;display:flex;align-items:center;text-align:left}.ds-transaction-row:hover{background:rgba(237,230,255,.45)}.ds-transaction-row:active{background:rgba(237,230,255,.75)}.ds-transaction-row:focus-visible{outline:3px solid #34D9EA;outline-offset:2px}.ds-transaction-icon{width:46px;height:46px;border-radius:15px;background:#EDE6FF;color:#6540D7;display:grid;place-items:center;font-size:22px}.ds-transaction-copy{min-width:0;flex:1;padding:0 12px;display:grid}.ds-transaction-copy strong,.ds-transaction-value strong{font-size:16px;line-height:22px}.ds-transaction-copy strong,.ds-transaction-value small{color:#6540D7}.ds-transaction-copy small,.ds-transaction-value small{font-size:11px;line-height:14px}.ds-transaction-copy small{color:#645E6C}.ds-transaction-value{display:grid;text-align:right}"
    },
    {
      "name": "Floating Bottom Navigation",
      "kind": "nav",
      "description": "Three-destination compact navigation inside a lifted glass capsule.",
      "html": "<nav class=\"ds-bottom-nav\"><button class=\"ds-nav-active\"><span>●</span>Home</button><button><span>◷</span>History</button><button><span>⚙</span>Settings</button></nav>",
      "css": ".ds-bottom-nav{padding:6px;border-radius:28px;background:rgba(252,249,255,.92);box-shadow:0 10px 20px rgba(13,9,20,.20);display:grid;grid-template-columns:repeat(3,1fr);font-family:sans-serif}.ds-bottom-nav button{min-height:64px;border:0;border-radius:22px;background:transparent;color:#645E6C;font:500 12px/16px sans-serif;display:grid;place-items:center}.ds-bottom-nav button span{font-size:19px}.ds-bottom-nav button:hover{background:rgba(237,230,255,.5)}.ds-bottom-nav button:active{transform:scale(.97)}.ds-bottom-nav button:focus-visible{outline:3px solid #34D9EA;outline-offset:-2px}.ds-bottom-nav .ds-nav-active{background:#EDE6FF;color:#6540D7}"
    },
    {
      "name": "Theme Choice",
      "kind": "custom",
      "refersTo": "theme-choice-selected",
      "description": "Accessible radio tile for System, Light, or Dark appearance.",
      "html": "<button class=\"ds-theme-choice\" role=\"radio\" aria-checked=\"true\"><span>◐</span>System</button>",
