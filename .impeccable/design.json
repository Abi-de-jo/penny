      { "name": "The Paired Theme Rule", "body": "Resolve semantic roles through the complete light or dark scheme. Never invert colors mechanically or mix roles from opposing schemes.", "section": "colors" },
      { "name": "The Amount Leads Rule", "body": "On money-focused surfaces, the monetary value receives the strongest available type role; labels explain it without competing.", "section": "typography" },
      { "name": "The Scale, Don't Improvise Rule", "body": "Use the defined Material type roles in scalable `sp`; do not introduce one-off text sizes inside screens.", "section": "typography" },
      { "name": "The Glass Must Read Rule", "body": "Translucency adds atmosphere only after foreground contrast is secure in both themes.", "section": "elevation" },
      { "name": "The Signature Earns Shadow Rule", "body": "Broad colored shadows belong to the lobe and brand moments; routine panels stay tonally layered.", "section": "elevation" }
